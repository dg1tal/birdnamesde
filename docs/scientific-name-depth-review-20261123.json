  "notableCases": {
    "Erithacus rubecula": "Latin erithacus via Greek erithakos, an ancient bird name; deeper origin unresolved. Rubecula is a diminutive related to ruber, not a ruber + gula compound.",
    "Dendrocopos / Dendrocoptes": "Distinct source forms: dendron + kopos versus dendron + kopto.",
    "Bombycilla": "Greek bombux + Modern Latin cilla; historical use of cilla as tail distinguished from Classical Latin.",
    "Neophema": "Greek neos combined with the earlier parrot genus Euphema; not simply a direct new + voice coinage.",
    "Melanocorypha": "Melas + an ancient bird name koruphos; the earlier unqualified black-crown gloss is replaced and uncertainty marked.",
    "Forpus": "Unexplained coined genus; proposed roots are not promoted to a certain etymology.",
    "Psittacara": "Conflicting analyses are identified instead of silently selecting a certain one.",
    "phoenicuroides / trochiloides / subminuta": "Earlier bird names and the applicable taxon-specific dictionary senses are identified."
  },
