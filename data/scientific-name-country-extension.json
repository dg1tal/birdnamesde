    "heineanumHeinei": {
      "title": "Museum Heineanum: Ferdinand Heine sen. (1809–1894), Begründer der Vogelsammlung",
      "url": "https://www.zobodat.at/pdf/Abh-Ber-Mus-Heineanum_SH_8_0010-0029.pdf",
      "sha256": "ab6e712e196c4971cb31fcd5e564e971fa0954e02c9f12c0e34ff592072d65c1"
    }
